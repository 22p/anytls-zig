msgid "AnyTLS Zig"
msgstr "AnyTLS Zig"

msgid "AnyTLS (protocol v2) client with a SOCKS5 inbound. TLS 1.3 with certificate chain and hostname verification."
msgstr "AnyTLS（协议 v2）客户端，提供 SOCKS5 本地入口，使用 TLS 1.3 并校验证书链与主机名。"

msgid "Settings"
msgstr "设置"

msgid "Enable"
msgstr "启用"

msgid "Start the client automatically when the system boots."
msgstr "系统启动时自动运行客户端。"

msgid "SOCKS5 listen address"
msgstr "SOCKS5 监听地址"

msgid "Use 0.0.0.0:1080 to serve the LAN; the default listens on loopback only."
msgstr "使用 0.0.0.0:1080 可供局域网使用；默认仅监听回环地址。"

msgid "Server address"
msgstr "服务器地址"

msgid "TLS server name (SNI)"
msgstr "TLS 服务器名称（SNI）"

msgid "Leave empty to use the server host name."
msgstr "留空则使用服务器主机名。"

msgid "Password"
msgstr "密码"

msgid "Stored in /etc/config/anytls-zig; keep that file readable by root only."
msgstr "保存在 /etc/config/anytls-zig 中；请确保该文件仅 root 可读。"

msgid "CA bundle"
msgstr "CA 证书包"

msgid "Empty uses the system CA bundle from the ca-bundle package."
msgstr "留空则使用 ca-bundle 软件包提供的系统 CA 证书。"

msgid "Disable TLS verification"
msgstr "关闭 TLS 校验"

msgid "DANGER: disables certificate chain and hostname checks. Do not enable in production."
msgstr "危险：会关闭证书链与主机名校验，请勿在生产环境启用。"

msgid "Connect timeout"
msgstr "连接超时"

msgid "Seconds (1-300)."
msgstr "单位：秒（1-300）。"

msgid "Warm idle sessions"
msgstr "预热空闲会话"

msgid "Sessions kept ready (0-64)."
msgstr "保持就绪的会话数量（0-64）。"

msgid "Idle timeout"
msgstr "空闲超时"

msgid "Seconds before an idle session is closed (5-86400)."
msgstr "空闲会话关闭前的等待秒数（5-86400）。"

msgid "Streams per session"
msgstr "每会话 stream 数"

msgid "Concurrent streams multiplexed on one session (1-4096)."
msgstr "单个会话上复用的并发 stream 数量（1-4096）。"

msgid "Half-close grace"
msgstr "半关闭宽限期"

msgid "Seconds to wait for the peer FIN after a local half close (0-3600)."
msgstr "本地半关闭后等待对端 FIN 的秒数（0-3600）。"

msgid "Log level"
msgstr "日志级别"

msgid "Error"
msgstr "错误"

msgid "Warning"
msgstr "警告"

msgid "Info"
msgstr "信息"

msgid "Debug"
msgstr "调试"

msgid "Serve PAC file"
msgstr "提供 PAC 文件"

msgid "Writes /www/anytls-zig.pac, served as http://<LAN-IP>/anytls-zig.pac. The proxy address is generated from the LAN address and the SOCKS5 port above, so set listen to 0.0.0.0:1080 for LAN clients."
msgstr "生成 /www/anytls-zig.pac，可通过 http://<LAN-IP>/anytls-zig.pac 访问。代理地址由 LAN 地址和上面的 SOCKS5 端口自动生成；要让局域网设备使用，请把监听地址设为 0.0.0.0:1080。"

msgid "PAC bypass domains"
msgstr "PAC 直连域名"

msgid "Extra domains that should go DIRECT, subdomains included. The built-in list already covers common Chinese sites."
msgstr "额外走直连的域名（包含子域名）。内置列表已覆盖常见中国站点。"
