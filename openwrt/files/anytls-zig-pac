#!/bin/sh
# Generate the PAC file for the AnyTLS mixed inbound (SOCKS5 + HTTP).
#
# The proxy address is derived from the listen option: a concrete listen
# address is used as-is, while 0.0.0.0/127.0.0.1 fall back to the LAN address
# (port stays the inbound port). Chinese domains are sent DIRECT. The proxy
# chain lists SOCKS5 first, then HTTP PROXY as a fallback for PAC engines
# that do not understand the SOCKS tokens.
#
# OpenWrt: reads /etc/config/anytls-zig (pac_enabled, listen, pac_bypass) and
# writes /www/anytls-zig.pac, which uhttpd serves as
# http://<lan-ip>/anytls-zig.pac.
#
# Testing/standalone: ANYTLS_PAC_LISTEN, ANYTLS_PAC_HOST, ANYTLS_PAC_BYPASS,
# ANYTLS_PAC_LIST, ANYTLS_PAC_OUT and ANYTLS_PAC_URL_FILE override the
# defaults, and no uci access is attempted when ANYTLS_PAC_LISTEN is set.

# No `set -u`: OpenWrt's /lib/functions.sh dereferences shell variables such as
# IPKG_INSTROOT that are not always set when the generator runs from procd.
OUT=${ANYTLS_PAC_OUT:-/www/anytls-zig.pac}
LIST=${ANYTLS_PAC_LIST:-/usr/share/anytls-zig/china-domains.txt}
URL_FILE=${ANYTLS_PAC_URL_FILE:-/tmp/anytls-zig.pac.url}
LISTEN=${ANYTLS_PAC_LISTEN:-}
HOST=${ANYTLS_PAC_HOST:-}
BYPASS=${ANYTLS_PAC_BYPASS:-}

append_bypass() {
	BYPASS="$BYPASS $1"
}

if [ -z "$LISTEN" ] && [ -r /lib/functions.sh ]; then
	. /lib/functions.sh
	. /lib/functions/network.sh 2>/dev/null || true
	config_load anytls-zig
	config_get LISTEN main listen "127.0.0.1:1080"
	config_list_foreach main pac_bypass append_bypass
fi

[ -n "$LISTEN" ] || LISTEN="127.0.0.1:1080"

case "$LISTEN" in
	\[*\]:*)
		lhost=${LISTEN%]:*}
		lhost=${lhost#[}
		lport=${LISTEN##*:}
		;;
	*:*)
		lhost=${LISTEN%:*}
		lport=${LISTEN##*:}
		;;
	*)
		lhost=$LISTEN
		lport=1080
		;;
esac
case "$lport" in
	''|*[!0-9]*) lport=1080 ;;
esac

lan_ip() {
	[ -n "$HOST" ] && { printf '%s\n' "$HOST"; return 0; }
	if command -v network_get_ipaddr >/dev/null 2>&1; then
		local ip
		network_get_ipaddr ip lan 2>/dev/null && [ -n "$ip" ] && { printf '%s\n' "$ip"; return 0; }
	fi
	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		local ip
		ip=$(ubus call network.interface.lan status 2>/dev/null |
			jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
		[ -n "$ip" ] && { printf '%s\n' "$ip"; return 0; }
	fi
	ip -4 addr show br-lan 2>/dev/null |
		awk '/inet /{sub(/\/.*/, "", $2); print $2; exit}'
}

case "$lhost" in
	127.0.0.1|'::1'|'[::1]')
		echo "anytls-zig-pac: listen is loopback; LAN clients cannot reach it" >&2
		;;
esac

LAN=$(lan_ip)
[ -n "$LAN" ] || {
	echo "anytls-zig-pac: LAN address not found, using the listen host" >&2
}

case "$lhost" in
	''|0.0.0.0|'::'|'[::]'|127.0.0.1|'::1'|'[::1]')
		phost=$LAN
		;;
	*)
		phost=$lhost
		;;
esac
[ -n "$phost" ] || phost=127.0.0.1
[ -n "$LAN" ] || LAN=$phost

domains() {
	{
		[ -r "$LIST" ] && cat "$LIST"
		printf '%s\n' "$BYPASS" | tr ', ' '\n\n'
	} |
		tr -d '\r' |
		sed -e 's/#.*//' -e 's/^[.[:space:]]*//' -e 's/[[:space:]]*$//' |
		tr 'A-Z' 'a-z' |
		grep -E '^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$' |
		awk '!seen[$0]++' |
		sort
}

mkdir -p "$(dirname "$OUT")" 2>/dev/null || {
	echo "anytls-zig-pac: cannot create $(dirname "$OUT")" >&2
	exit 1
}
tmp="$OUT.$$"
{
	echo '// Generated by anytls-zig from /etc/config/anytls-zig. Do not edit.'
	echo "var PROXY = \"SOCKS5 ${phost}:${lport}; SOCKS ${phost}:${lport}; PROXY ${phost}:${lport}; DIRECT\";"
	echo 'var BYPASS = ['
	domains | while read -r d; do
		[ -n "$d" ] && printf '    "%s",\n' "$d"
	done
	echo '];'
	cat <<'JS'
function FindProxyForURL(url, host) {
    host = host.toLowerCase();
    if (isPlainHostName(host) || host === "localhost" || host === "::1" ||
        shExpMatch(host, "*.local") || shExpMatch(host, "*.lan") ||
        shExpMatch(host, "*.internal")) {
        return "DIRECT";
    }
    // Private IPv4 literals, without triggering a DNS lookup.
    var m = /^(\d+)\.(\d+)\.(\d+)\.(\d+)$/.exec(host);
    if (m) {
        var a = +m[1], b = +m[2];
        if (a === 10 || a === 127 || (a === 192 && b === 168) ||
            (a === 172 && b >= 16 && b <= 31) || (a === 169 && b === 254)) {
            return "DIRECT";
        }
    }
    for (var i = 0; i < BYPASS.length; i++) {
        var d = BYPASS[i];
        if (host === d || dnsDomainIs(host, "." + d)) return "DIRECT";
    }
    return PROXY;
}
JS
} > "$tmp" || {
	rm -f "$tmp"
	echo "anytls-zig-pac: cannot write $tmp" >&2
	exit 1
}
chmod 644 "$tmp"
mv "$tmp" "$OUT" || {
	rm -f "$tmp"
	echo "anytls-zig-pac: cannot replace $OUT" >&2
	exit 1
}

printf 'http://%s/anytls-zig.pac\n' "$LAN" > "$URL_FILE" 2>/dev/null || true
