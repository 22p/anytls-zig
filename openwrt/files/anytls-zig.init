#!/bin/sh /etc/rc.common
# AnyTLS Zig client service for OpenWrt (procd)

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/anytls-zig

start_service() {
	config_load anytls-zig

	config_get listen          main listen          "127.0.0.1:1080"
	config_get server          main server          ""
	config_get sni             main sni             ""
	config_get password        main password        ""
	config_get ca              main ca              ""
	config_get min_idle        main min_idle        "5"
	config_get idle_timeout    main idle_timeout    "30"
	config_get connect_timeout main connect_timeout "10"
	config_get max_streams     main max_streams     "128"
	config_get half_close_wait main half_close_wait "3"
	config_get log_level       main log_level       "info"
	config_get_bool insecure   main insecure        0

	[ -n "$server" ] || {
		logger -t anytls-zig "server is not configured, not starting"
		return 0
	}
	[ -n "$password" ] || {
		logger -t anytls-zig "password is not configured, not starting"
		return 0
	}

	procd_open_instance
	procd_set_param command "$PROG" \
		-l "$listen" \
		-s "$server" \
		--min-idle "$min_idle" \
		--idle-timeout "$idle_timeout" \
		--connect-timeout "$connect_timeout" \
		--max-streams "$max_streams" \
		--half-close-wait "$half_close_wait" \
		--log-level "$log_level"

	[ -n "$sni" ] && procd_append_param command --sni "$sni"
	[ -n "$ca" ] && procd_append_param command --ca "$ca"
	[ -n "$password" ] && procd_append_param command -p "$password"
	[ "$insecure" = "1" ] && procd_append_param command --insecure

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "anytls-zig"
}
