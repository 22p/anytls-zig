# AnyTLS Zig client - UCI example
# The password is stored in this file; keep it readable by root only:
#   chmod 600 /etc/config/anytls-zig

config anytls-zig 'main'
	option enabled '0'
	option listen '127.0.0.1:1080'
	option server 'example.com:443'
	option sni 'example.com'
	option password 'your-password'

	# Optional: custom CA bundle. Empty uses the system bundle from ca-bundle.
	option ca ''

	option min_idle '5'
	option idle_timeout '30'
	option connect_timeout '10'
	option max_streams '128'
	option half_close_wait '3'
	option log_level 'info'

	# Never enable this on a real deployment; it disables certificate and
	# hostname verification.
	option insecure '0'
